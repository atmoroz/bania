# ---- Supabase: client side (safe to expose to the browser) ----
# "Publishable key" (sb_publishable_...) — replaces the legacy anon key.
# Safe in the browser ONLY because Row Level Security is enabled on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Supabase: server side (NEVER expose to the browser) ----
# "Secret key" (sb_secret_...) — replaces the legacy service_role key. Bypasses RLS.
# Only needed for privileged operations that cannot run as the signed-in admin.
# Leave empty until something actually requires it.
SUPABASE_SECRET_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Telegram notifications (backlog, see docs/BACKLOG.md) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
